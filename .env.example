"""
Environment Variables Template
Copy to .env and fill in your values
"""

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trustshield_ai
REDIS_URL=redis://localhost:6379/0
MONGODB_URI="YOUR_MONGODB_URI"
MONGODB_DATABASE="YOUR_DB_NAME"
MONGODB_COLLECTION=analyses

# FastAPI
HOST=0.0.0.0
PORT=8000
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Providers
AI_PROVIDER=openai  # Options: local, openai, gemini, claude
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
CLAUDE_API_KEY=...
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY_1=your-ollama-key
PHISHING_MODEL_PATH=../phishing_model.pkl
SPAM_DATASET_PATH=../spam.csv

# Extension
EXTENSION_ID=your-chrome-extension-id
EXTENSION_VERSION=1.0.0
ALLOWED_EXTENSION_ORIGINS=chrome-extension://your-extension-id

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
MAX_EMAIL_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60
SESSION_TIMEOUT_MINUTES=1440

# Features
ENABLE_THREAT_INTELLIGENCE_FEED=True
ENABLE_ML_MODEL=True
ENABLE_COMMUNITY_REPORTING=True
